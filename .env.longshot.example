# .env.longshot — strategy profile overlay (P1)
#
# Copy to `.env.longshot` (gitignored, like `.env`) and select it with:
#
#     python scripts/scan.py sports --profile longshot ...
#
# ── How an overlay works ────────────────────────────────────────────────────
#
# The base `.env` loads first; this file is then applied on top, and ONLY the
# keys written here differ. Everything absent is inherited — which is the whole
# point: risk gates, fee model, calibration, per-sport floors, the NFL freeze
# and every bug fix stay in lockstep across both books automatically.
#
# That inheritance is a real upgrade over the separate Edge-Radar-Longshot
# repo this replaced. That fork shipped with `MAX_OPEN_EXPOSURE_PCT=0`,
# `MAX_SEGMENT_EXPOSURE_PCT=0`, `MAX_DAYS_TO_EVENT_FOR_GAME_MARKETS=0`,
# `MAX_BET_SIZE=100` and `MAX_DAILY_LOSS=250` — not by decision but because
# nobody had re-tightened the shipped defaults after cloning, while its own
# ROADMAP recorded the risk posture as "conservative, matches main repo, no
# change needed". Those five gates now come from the base `.env` and match.
#
# **A missing overlay file is a hard error, not a fallback.** `--profile
# longshto` will refuse to run rather than quietly bet the main bankroll with
# longshot settings. See `apply_profile_overlay()` in app/config.py.

# ── Bankroll isolation ──────────────────────────────────────────────────────
# THE reason this profile exists. A Kalshi subaccount is an exchange-enforced
# separate wallet under the same login: separate balance, separate positions,
# separate orders. Neither a second API key nor a second checkout of this repo
# isolates anything — both still draw on one balance.
#
# Requires Advanced API tier. Created once via `client.create_subaccount()`;
# subaccount 1 was created and funded 2026-09-07/08. 0 = the primary account.
KALSHI_SUBACCOUNT=1

# ── Execution posture ───────────────────────────────────────────────────────
# The base `.env` runs Kalshi LIVE (`DRY_RUN=false`). This profile is still in
# its evidence window and must not inherit that. Do not remove this line
# without a deliberate decision to put real money on the longshot strategy.
DRY_RUN=true

# ── Strategy knobs ──────────────────────────────────────────────────────────

# Gate 3.5 lottery-ticket floor. Base `.env` runs 0.10.
#
# ⚠️ OPEN QUESTION — this value is contradicted by our own backtest. The
# 8-12c band that 0.08 newly admits went **0W-36L (-103.3% ROI)** across all
# six settled months, while the 0-8c band it still excludes holds the book's
# two biggest winners. The ROADMAP's standing recommendation is to decide
# **0.12 or 0.06, not 0.08**, and to look at `spread`-as-category (23% win,
# +31.7% ROI, n=111) as the better-evidenced route to a longshot profile.
# Carried over as-is from the fork so the merge changed no strategy; resolve
# it before this profile ever goes live.
MIN_MARKET_PRICE=0.08

# Gate 6 per-event cap, futures only. Games stay at the base `MAX_PER_EVENT`.
# A diversified multi-outcome futures book (3 underdogs in one championship)
# partitions a single event rather than doubling down on it, so it earns a
# wider cap than 3 sides of one game would.
MAX_PER_EVENT_FUTURES=3
