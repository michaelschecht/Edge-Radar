.DS_Store
Thumbs.db

# === Notebooks ===
notebooks/.ipynb_checkpoints/
notebooks/analysis/*.html


# === Project-specific ===
.claude/images/screenshots/
.claude/memory/
.claude/agents/
# Personal scratch/working docs — same intent as the "My Scripts" block below.
.claude/temp/
# Edge-Radar skills: canonical source lives in /Skills. These two .claude/skills
# entries are local Windows junctions pointing there (git core.symlinks=false, so
# real symlinks can't be tracked). Ignore them so the content is tracked exactly
# once under /Skills. Recreate the junctions after a fresh clone with:
#   pwsh -File scripts/setup/link_skills.ps1
.claude/skills/edge-radar/
.claude/skills/edge-radar-analysis/
docs/my-documents/
# Published account-growth graph: lives on master, refreshed weekly by the gh API
# push in scripts/schedulers/automation/refresh_account_graph.py. Kept out of branch
# PRs so the out-of-band master commits never conflict.
.claude/html/account-*.html


# === My Scripts ===
scripts/custom/
# Ignore schedulers by default (many .bat files hardcode local paths),
# but track the portable automation/ folder (paths derived from __file__, no secrets).
scripts/schedulers/*
!scripts/schedulers/automation/
!scripts/schedulers/automation/**
scripts/schedulers/automation/__pycache__/

# === Repos ===
/repos/
# aX Platform CLI config (contains token)
.ax/
